# BotFather token. Keep ONLY in Bothost environment, never in GitHub.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric IDs; use /id to learn yours.
TELEGRAM_OWNER_IDS=
# Existing ZDRAVA counter ID. API token must have read access.
METRIKA_COUNTER_ID=113941063
METRIKA_TOKEN=
# Optional: goal ID for an outbound link to Ozon; if absent, don't show a number.
METRIKA_OZON_GOAL_ID=
# Optional Google Search Console: paste base64 of service-account JSON into Bothost ENV.
# Never paste the real JSON or key into GitHub. File fallback is also supported.
GSC_PROPERTY=sc-domain:zdrava.top
GSC_SERVICE_ACCOUNT_B64=
GSC_SERVICE_ACCOUNT_FILE=/app/data/gsc-service-account.json
# /app/data persists across Bothost redeploys on plans with persistent storage.
DATA_DIR=/app/data
TIMEZONE=Europe/Moscow
DAILY_REPORT_TIME=09:00
DAILY_REPORT_ENABLED=true
HTTP_TIMEOUT_SECONDS=20
